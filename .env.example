# One deployment = one client = one .env file — never shared across stacks, never
# committed with real values (architecture/03-technology-stack.md, constitution
# "Isolation model"). Copy this file to .env and fill in real values for local dev.

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agentic_churn
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/agentic_churn

# app_role / shredder_role grants (data-base/10-ddl-appendix.md §Roles and grants) —
# change these for any non-local deployment.
APP_ROLE_PASSWORD=app_role_dev_password
SHREDDER_ROLE_PASSWORD=shredder_role_dev_password

# --- Encryption (Phase 1: manual key file; Phase 2: Cloud KMS — architecture/03) ---
# Path to the per-deployment data key used for pgcrypto column-level encryption of
# message bodies. Never commit the key file itself.
ENCRYPTION_KEY_PATH=./secrets/data.key
# Identifier stored in events.data_key_ref / raw_envelopes.data_key_ref (never the key
# itself) — one active key per deployment in Phase 1 (specs/003-ingestion-and-context/
# research.md), so a static identifier is enough until Phase 11 key rotation.
ENCRYPTION_KEY_ID=local-v1

# --- Client profile (specs/003-ingestion-and-context) ---
# The CS lead edits this YAML file directly (MVP) — POST /api/profile/reload re-reads it.
CLIENT_PROFILE_PATH=./demo/client-profile.yaml

# --- Host-side port overrides (FR-010) ---
# Defaults below match docker-compose.yml's fallback values — override only if one of
# these ports is already in use on your machine (spec.md Edge Cases: port conflicts).
API_PORT=8000
DB_PORT=5432
WEB_PORT=5173

# --- Auth (specs/002-dashboard-shell) ---
# Must match the host-side URL the browser actually loads the frontend from — if you
# override WEB_PORT above, update this too.
WEB_ORIGIN=http://localhost:5173
TOKEN_LIFETIME_HOURS=12

# --- Readers (specs/005-deterministic-findings, specs/007-model-findings) ---
# Recurrence reader's embedding provider — no default, must be set for real use.
OPENAI_API_KEY=
# Tone/Intent readers' model provider — no default, must be set for real use.
ANTHROPIC_API_KEY=
READER_MODEL_ID=claude-haiku-4-5-20251001

# --- Narrator / Ask agent (specs/008-narrator-and-ask-agent) ---
# Same ANTHROPIC_API_KEY above, a higher-stakes-generation model tier.
GENERATION_MODEL_ID=claude-sonnet-5
